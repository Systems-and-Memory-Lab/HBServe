  "experiment_id": "miniquick-70b-serving-v1",
  "purpose": "Miniquick default serving window: four sequential arrivals fill to 20,480 tokens by 2,048-token chunks while every already-filled context decodes one token per iteration in the same forward pass (continuous batching; weight reads shared), then a four-step decode tail over the grown histories. This combined prefill+decode stream is the default comparison scenario, including a cached CXL-SSD overflow row whose writes complete at protected device-internal DRAM acceptance; the per-window prefill:decode token ratio is structural (arrival-driven), not production-anchored.",
  "population": {
    "model_descriptor": "../../models/llama31-70b-w8a16-kv-bf16.json",
    "target_population_bytes": 100000000000,
    "runtime_overhead_bytes": 1073741824,
    "construction": "largest_whole_kv_block_population_within_aligned_address_space_target",
    "topology_independent": true
  },
  "workload": {
    "kind": "fixed_prefill_decode_memory_window",
    "kv_context_count": 4,
    "prefill_contexts": 0,
    "prefill_tokens_per_context": 0,
    "decode_contexts": 4,
    "decode_tokens_per_context": 1,
    "random_decode_contexts": 0,
    "random_read_chunk_blocks": 128,
    "locality_seed": 20260827,
    "compute_time": "not_modeled",
    "initial_state": "model_weights_installed_and_kv_arena_empty;_arrivals_fill_while_filled_contexts_decode_each_iteration",
    "execution_order": "per_chunk:_block_allocation_then_embedding_then_per_layer_weight_read_history_read_and_chunk_kv_write;_then_output_head_then_decode_steps_then_final_drain",
    "kv_storage_order": "layer_major",
    "context_parallelism": "growth_contexts_are_sequential_arrivals;_decode_contexts_are_parallel;_random_kv_extents_of_a_context_issue_concurrently_and_its_append_waits_for_all_of_them",
    "implementation": "address_ranges_only_without_payload_materialization",
    "same_trace_for_every_topology": true,
    "window_shape": "prefill_growth",
    "context_length_basis": "20,480 tokens is the miniquick tenth-scale target reached inside the window from the model-loaded state; chunk 2,048 tokens",
    "decode_steps_per_window": 4,
    "prefill_growth_contexts": 4,
    "prefill_target_tokens": 20480,
    "prefill_chunk_tokens": 2048,
    "prefill_growth_schedule": "sequential",
    "prefill_growth_decode_while_filling": true
  },
